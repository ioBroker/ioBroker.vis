// Type checking ("npm run check"), ESLint and editor support. The build uses tsconfig.build.json.
// The browser part (www/) is not checked.
{
    "compilerOptions": {
        "noEmit": true,
        "target": "es2022",
        "lib": ["es2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node", "@iobroker/types"],
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "useUnknownInCatchVariables": false,
        // only for the two small files in lib/ that forward to build/
        "allowJs": true,
        "checkJs": false
    },
    "include": ["src/**/*.ts", "tasks.ts", "lib/*.js"],
    "exclude": ["node_modules", "build"]
}
